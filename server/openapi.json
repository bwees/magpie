{
	"components": {
		"schemas": {
			"BackupResponse": {
				"description": "BackupResponse schema",
				"properties": {
					"createdAt": {
						"format": "date-time",
						"type": "string"
					},
					"kind": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"size": {
						"format": "int64",
						"type": "integer"
					}
				},
				"required": [
					"createdAt",
					"kind",
					"name",
					"size"
				],
				"type": "object"
			},
			"ErrorItem": {
				"properties": {
					"more": {
						"additionalProperties": {
							"description": "Additional information about the error"
						},
						"description": "Additional information about the error",
						"type": [
							"object",
							"null"
						]
					},
					"name": {
						"description": "For example, name of the parameter that caused the error",
						"type": "string"
					},
					"reason": {
						"description": "Human readable error message",
						"type": "string"
					}
				},
				"required": [
					"name",
					"reason"
				],
				"type": "object"
			},
			"HTTPError": {
				"description": "HTTPError schema",
				"properties": {
					"detail": {
						"description": "Human readable error message",
						"type": "string"
					},
					"errors": {
						"items": {
							"$ref": "#/components/schemas/ErrorItem"
						},
						"type": [
							"array",
							"null"
						]
					},
					"instance": {
						"type": "string"
					},
					"status": {
						"description": "HTTP status code",
						"example": 403,
						"type": "integer"
					},
					"title": {
						"description": "Short title of the error",
						"type": "string"
					},
					"type": {
						"description": "URL of the error type. Can be used to lookup the error in a documentation",
						"type": "string"
					}
				},
				"type": "object"
			},
			"HealthResponse": {
				"description": "HealthResponse schema",
				"properties": {
					"status": {
						"type": "string"
					}
				},
				"required": [
					"status"
				],
				"type": "object"
			},
			"ParkedEventResponse": {
				"description": "ParkedEventResponse schema",
				"properties": {
					"aggregateId": {
						"type": "string"
					},
					"attempts": {
						"type": "integer"
					},
					"eventId": {
						"type": "string"
					},
					"eventType": {
						"type": "string"
					},
					"handler": {
						"type": "string"
					},
					"lastError": {
						"type": "string"
					},
					"parkedAt": {
						"format": "date-time",
						"type": "string"
					}
				},
				"required": [
					"aggregateId",
					"attempts",
					"eventId",
					"eventType",
					"handler",
					"lastError",
					"parkedAt"
				],
				"type": "object"
			},
			"RestoreResponse": {
				"description": "RestoreResponse schema",
				"properties": {
					"restarting": {
						"type": "boolean"
					}
				},
				"required": [
					"restarting"
				],
				"type": "object"
			},
			"RetryParkedEventRequest": {
				"description": "RetryParkedEventRequest schema",
				"properties": {
					"eventId": {
						"type": "string"
					},
					"handler": {
						"type": "string"
					}
				},
				"required": [
					"eventId",
					"handler"
				],
				"type": "object"
			},
			"unknown-interface": {
				"description": "unknown-interface schema"
			}
		}
	},
	"info": {
		"description": "HTTP API of the Magpie server. Errors are RFC 9457 problem JSON.",
		"title": "Magpie",
		"version": "1.0.0"
	},
	"openapi": "3.1.0",
	"paths": {
		"/api/health": {
			"get": {
				"description": "#### Controller: \n\n`magpie/internal/platform/httpserver.(*HealthController).Register.func1`\n\n---\n\n",
				"operationId": "getHealth",
				"parameters": [
					{
						"in": "header",
						"name": "Accept",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthResponse"
								}
							}
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							},
							"application/xml": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							}
						},
						"description": "Bad Request _(validation or deserialization error)_"
					},
					"500": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							},
							"application/xml": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							}
						},
						"description": "Internal Server Error _(panics)_"
					}
				},
				"summary": "Report that the server is up",
				"tags": [
					"api",
					"platform"
				]
			}
		},
		"/api/platform/backups": {
			"get": {
				"description": "#### Controller: \n\n`magpie/internal/platform/backup.(*Controller).list`\n\n---\n\n",
				"operationId": "listBackups",
				"parameters": [
					{
						"in": "header",
						"name": "Accept",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": {
										"$ref": "#/components/schemas/BackupResponse"
									},
									"type": "array"
								}
							}
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							},
							"application/xml": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							}
						},
						"description": "Bad Request _(validation or deserialization error)_"
					},
					"500": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							},
							"application/xml": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							}
						},
						"description": "Internal Server Error _(panics)_"
					}
				},
				"summary": "List database backups, newest first (admin)",
				"tags": [
					"api",
					"platform"
				]
			}
		},
		"/api/platform/backups/{name}/restore": {
			"post": {
				"description": "#### Controller: \n\n`magpie/internal/platform/backup.(*Controller).restore`\n\n---\n\n",
				"operationId": "restoreBackup",
				"parameters": [
					{
						"description": "Backup file name from listBackups",
						"in": "path",
						"name": "name",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "header",
						"name": "Accept",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"202": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestoreResponse"
								}
							}
						},
						"description": "Accepted"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							},
							"application/xml": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							}
						},
						"description": "Bad Request _(validation or deserialization error)_"
					},
					"500": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							},
							"application/xml": {
								"schema": {
									"$ref": "#/components/schemas/HTTPError"
								}
							}
						},
						"description": "Internal Server Error _(panics)_"
					}
				},
				"summary": "Restore a backup and restart the server (admin)",
				"tags": [
					"api",
					"platform"
				]
			}
		},
		"/api/platform/parked-events": {
			"get": {
				"description": "#### Controller: \n\n`magpie/internal/platform/bus.(*Controller).listParked`\n\n---\n\n",
				"operationId": "listParkedEvents",
				"parameters": [
					{
						"in": "header",
						"name": "Accept",
						"schema": {
							"type": "string"
						}
