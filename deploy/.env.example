# Shared secret agents present, at least 32 characters. Generate one with: openssl rand -hex 32
MAGPIE_AGENT_SECRET=

# Host directory holding downloads and the library (see compose.yaml).
MEDIA_DIR=/srv/media

# Public URL of Magpie, used in notification links and agent instructions.
MAGPIE_BASE_URL=http://magpie.lan:3000

MAGPIE_PORT=3000
MAGPIE_CONFIG_DIR=./config

# Host render group for Intel/AMD agents: getent group render | cut -d: -f3
RENDER_GID=109

PUID=1000
PGID=1000
TZ=Etc/UTC
